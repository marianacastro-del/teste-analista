function doGet(e) {
  // Loga TUDO que chega para debug
  Logger.log('RAW e: ' + JSON.stringify(e));
  Logger.log('queryString: ' + (e.queryString || 'vazio'));
  Logger.log('parameter: ' + JSON.stringify(e.parameter || {}));
  Logger.log('parameters: ' + JSON.stringify(e.parameters || {}));

  var p = {};

  // Tenta todas as formas possíveis de ler os dados
  if (e.queryString && e.queryString.length > 0) {
    e.queryString.split('&').forEach(function(pair) {
      var kv = pair.split('=');
      if (kv.length >= 2) {
        p[decodeURIComponent(kv[0])] = decodeURIComponent(kv.slice(1).join('=').replace(/\+/g,' '));
      }
    });
    Logger.log('Lido via queryString manual');
  } else if (e.parameter && Object.keys(e.parameter).length > 0) {
    p = e.parameter;
    Logger.log('Lido via e.parameter');
  }

  Logger.log('p final: ' + JSON.stringify(p));

  // Só envia se tiver nome
  if (p.nome && p.nome !== 'undefined') {
    criarDocEEnviar(p);
  } else {
    Logger.log('DADOS VAZIOS — nao enviou');
  }

  return ContentService
    .createTextOutput(JSON.stringify({ status: 'ok', recebido: JSON.stringify(p) }))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  return doGet(e);
}

