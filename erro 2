function criarDocEEnviar(p) {
  var doc = DocumentApp.create('Teste Analista Financeiro Jr — ' + (p.nome || 'Candidato'));
  var body = doc.getBody();

  var styleTitle = {};
  styleTitle[DocumentApp.Attribute.FONT_SIZE] = 16;
  styleTitle[DocumentApp.Attribute.BOLD] = true;
  styleTitle[DocumentApp.Attribute.FOREGROUND_COLOR] = '#1D4ED8';

  var styleSection = {};
  styleSection[DocumentApp.Attribute.FONT_SIZE] = 11;
  styleSection[DocumentApp.Attribute.BOLD] = true;
  styleSection[DocumentApp.Attribute.FOREGROUND_COLOR] = '#374151';

  var styleLabel = {};
  styleLabel[DocumentApp.Attribute.FONT_SIZE] = 10;
  styleLabel[DocumentApp.Attribute.BOLD] = true;
  styleLabel[DocumentApp.Attribute.FOREGROUND_COLOR] = '#6B7280';

  var styleAnswer = {};
  styleAnswer[DocumentApp.Attribute.FONT_SIZE] = 11;
  styleAnswer[DocumentApp.Attribute.BOLD] = false;
  styleAnswer[DocumentApp.Attribute.FOREGROUND_COLOR] = '#111827';

  var styleGabarito = {};
  styleGabarito[DocumentApp.Attribute.FONT_SIZE] = 10;
  styleGabarito[DocumentApp.Attribute.BOLD] = false;
  styleGabarito[DocumentApp.Attribute.FOREGROUND_COLOR] = '#059669';
  styleGabarito[DocumentApp.Attribute.ITALIC] = true;

  // Cabeçalho
  var title = body.appendParagraph('Teste — Analista Financeiro Jr I');
  title.setAttributes(styleTitle);
  title.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  body.appendParagraph('');

  // Calcula nota
  var gabarito = { q2: 'B', q4: 'B', q5: 'B', q10: 'B' };
  var acertos = 0;
  var totalMC = 4;
  Object.keys(gabarito).forEach(function(key) {
    var resposta = (p[key] || '').replace('Alternativa ', '').trim().toUpperCase();
    if (resposta === gabarito[key]) acertos++;
  });
  var percMC = Math.round((acertos / totalMC) * 100);

  // Tabela info + nota
  var info = body.appendTable([
    ['Candidato(a)', p.nome || '-'],
    ['Tempo de resolução', p.tempo || '-'],
    ['Data', Utilities.formatDate(new Date(), 'America/Sao_Paulo', 'dd/MM/yyyy HH:mm')],
    ['Múltipla escolha', acertos + ' de ' + totalMC + ' corretas (' + percMC + '%)']
  ]);
  info.setColumnWidth(0, 160);
  info.setColumnWidth(1, 340);
  for (var i = 0; i < 4; i++) {
    info.getCell(i, 0).setBackgroundColor('#EFF6FF');
  }

  body.appendParagraph('');

  var respostasIdeais = {
    q1: 'Priorizaria as NFs com vencimento mais próximo para evitar multa e juros. Em empate, priorizaria o maior valor ou fornecedor mais rigoroso, comunicando o gestor sobre a terceira NF.',
    q2: 'Alternativa B',
    q3: 'CNPJ e razão social do fornecedor, dados bancários (banco, agência, conta ou PIX), número e valor da NF, data de vencimento, forma de pagamento e aprovação do gestor.',
    q4: 'Alternativa B',
    q5: 'Alternativa B',
    q6: 'R$ 3.459,50 a ser pago para Distribuidora Alfa Ltda., via boleto bancário, com vencimento em 05/06/2025.',
    q7: 'Desconto de R$ 55,50 aplicado sobre o item Caneta esferográfica cx c/50.',
    q8: 'R$ 499,50 ÷ 30 = R$ 16,65 por caixa.',
    q9: 'Número da NF, CNPJ do emitente, valor total, data de vencimento e forma de pagamento.',
    q10: 'Alternativa B'
  };

  var todasQuestoes = [
    { id: 'q1',  label: 'Q1 — Priorização de NFs', tipo: 'aberta', sec: 1 },
    { id: 'q2',  label: 'Q2 — Conciliação bancária', tipo: 'mc', sec: 1 },
    { id: 'q3',  label: 'Q3 — Informações para pagamento', tipo: 'aberta', sec: 1 },
    { id: 'q4',  label: 'Q4 — Função Excel SOMASE', tipo: 'mc', sec: 1 },
    { id: 'q5',  label: 'Q5 — NF com dados errados', tipo: 'mc', sec: 1 },
    { id: 'q6',  label: 'Q6 — Valor, destinatário e vencimento', tipo: 'aberta', sec: 2 },
    { id: 'q7',  label: 'Q7 — Desconto da NF', tipo: 'aberta', sec: 2 },
    { id: 'q8',  label: 'Q8 — Valor por caixa de caneta', tipo: 'aberta', sec: 2 },
    { id: 'q9',  label: 'Q9 — Campos importantes no lançamento', tipo: 'aberta', sec: 2 },
    { id: 'q10', label: 'Q10 — Pagamento antecipado', tipo: 'mc', sec: 2 }
  ];

  var secAtual = 0;
  todasQuestoes.forEach(function(q) {
    if (q.sec !== secAtual) {
      secAtual = q.sec;
      var secLabel = secAtual === 1 ? 'PARTE 1 — OPERACIONAL' : 'PARTE 2 — PRÁTICO (NOTA FISCAL)';
      var secPar = body.appendParagraph(secLabel);
      secPar.setAttributes(styleSection);
      secPar.setSpacingBefore(14);
      body.appendHorizontalRule();
    }

    var labelPar = body.appendParagraph(q.label);
    labelPar.setAttributes(styleLabel);
    labelPar.setSpacingBefore(10);

    var resposta = p[q.id] || '(sem resposta)';
    var respostaPar = body.appendParagraph('Resposta: ' + resposta);
    respostaPar.setAttributes(styleAnswer);

    if (q.tipo === 'mc' && gabarito[q.id]) {
      var respostaLetra = resposta.replace('Alternativa ', '').trim().toUpperCase();
      var acertou = respostaLetra === gabarito[q.id];
      var statusPar = body.appendParagraph(acertou ? '✓ Correto' : '✗ Incorreto — Gabarito: Alternativa ' + gabarito[q.id]);
      var styleStatus = {};
      styleStatus[DocumentApp.Attribute.FONT_SIZE] = 10;
      styleStatus[DocumentApp.Attribute.BOLD] = true;
      styleStatus[DocumentApp.Attribute.FOREGROUND_COLOR] = acertou ? '#059669' : '#DC2626';
      statusPar.setAttributes(styleStatus);
    }

    var idealPar = body.appendParagraph('Resposta ideal: ' + respostasIdeais[q.id]);
    idealPar.setAttributes(styleGabarito);
  });

  body.appendParagraph('');
  var rodape = body.appendParagraph('Múltipla escolha: ' + acertos + '/' + totalMC + ' (' + percMC + '%) · Gabarito: Q2=B · Q4=B · Q5=B · Q10=B');
  rodape.setAttributes(styleGabarito);
  rodape.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

  doc.saveAndClose();

  var docId = doc.getId();
  var pdfBlob = DriveApp.getFileById(docId).getAs('application/pdf');
  pdfBlob.setName('Teste_' + (p.nome || 'Candidato').replace(/ /g,'_') + '.pdf');

  var subject = 'Teste Analista Financeiro Jr — ' + (p.nome || 'Candidato');
  var emailBody = 'Olá,\n\nSegue em anexo o resultado do teste de ' + (p.nome || 'Candidato') + '.'
    + '\n\nTempo de resolução: ' + (p.tempo || '-')
    + '\nMúltipla escolha: ' + acertos + '/' + totalMC + ' (' + percMC + '%)'
    + '\n\nLink Google Docs: https://docs.google.com/document/d/' + docId
    + '\n\nAtenciosamente,\nSistema de Seleção';

  GmailApp.sendEmail('financeiro@vende-c.com', subject, emailBody, {
    attachments: [pdfBlob],
    name: 'Sistema de Seleção'
  });

  Logger.log('Enviado! Doc: ' + docId);
}
